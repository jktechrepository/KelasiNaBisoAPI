{
  "ConnectionStrings": {
    "KelasiConnection": "Server=localhost;Port=3306;Database=KelasiNaBiso;User=YOUR_USER;Password=YOUR_PASSWORD;"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS",
    "Issuer": "KelasiNaBiso",
    "Audience": "KelasiNaBisoUsers",
    "ExpirationMinutes": "1440"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "ServerVersion": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com",
      "https://admin.example.com"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [ "127.0.0.1", "::1" ],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      }
    ]
  },
  "Firebase": {
    "CredentialsPath": "firebase-credentials.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
