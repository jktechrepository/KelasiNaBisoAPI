  <ItemGroup>
    <Folder Include="wwwroot\Images\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="firebase-credentials.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="kelasinabiso-de502-firebase-adminsdk-fbsvc-954ac3e526.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Reports\Templates\*.frx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Reports\Templates\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Reports\Templates\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclure les fichiers de test du projet principal -->
    <Compile Remove="KelasiNaBiso.Tests.Unit/**" />
    <Compile Remove="KelasiNaBiso.Tests.Integration/**" />
    <Content Remove="KelasiNaBiso.Tests.Unit/**" />
    <Content Remove="KelasiNaBiso.Tests.Integration/**" />
    <EmbeddedResource Remove="KelasiNaBiso.Tests.Unit/**" />
    <EmbeddedResource Remove="KelasiNaBiso.Tests.Integration/**" />
    <None Remove="KelasiNaBiso.Tests.Unit/**" />
    <None Remove="KelasiNaBiso.Tests.Integration/**" />
