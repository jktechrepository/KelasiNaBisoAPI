### 🧪 TESTS : UNICITÉ DES MATRICULES (ÉLÈVES ET AGENTS)
### Objectif : Vérifier la génération de matricules uniques avec format GUID partiel

@baseUrl = https://localhost:7105
@token = {{auth_response.response.body.accessToken}}

################################################################################
### ÉTAPE 1 : Authentification
################################################################################

### 1. Authentifier un utilisateur pour obtenir le token JWT
# @name auth_response
POST {{baseUrl}}/api/Utilisateur/authentifier
Content-Type: application/json

{
  "emailOuTelephone": "admin@kelasinabiso.cd",
  "motDePasse": "Admin"
}

################################################################################
### ÉTAPE 2 : TESTS MATRICULE ÉLÈVE
################################################################################

### 2. ✅ Créer une inscription (élève) - Premier matricule généré
# @name inscription1
POST {{baseUrl}}/api/Inscription
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "Nouveau",
  "idEcole": 1,
  "idClasse": 1,
  "idAnneeScolaire": 1,
  "dateInscription": "2025-10-27",
  "statutInscription": "Confirmée",
  "nomEleve": "Kabongo",
  "postnomEleve": "Jean",
  "prenomEleve": "Pierre",
  "genreEleve": "M",
  "dateNaissanceEleve": "2010-05-15",
  "lieuNaissanceEleve": "Kinshasa",
  "nationaliteEleve": "Congolaise",
  "provinceEleve": "Kinshasa",
  "villeEleve": "Kinshasa",
  "communeEleve": "Kalamu",
  "quartierEleve": "Gombe",
  "avenueEleve": "Maniema",
  "numeroEleve": "123",
  "nomCompletTuteur": "Kabongo Senior",
  "genreTuteur": "M",
  "emailTuteur": "senior@kabongo.cd",
  "telephoneTuteur": "+243812345678"
}

###
### ⚠️ RÉSULTAT ATTENDU :
### - Status: 201 Created
### - Matricule généré : Format "ESK25-XXXXXX" (12 caractères)
### - Exemple: "ESK25-A3F2B1"

################################################################################

